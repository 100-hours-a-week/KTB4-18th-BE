FROM eclipse-temurin:25-jdk-noble AS build
WORKDIR /workspace
COPY gradlew build.gradle settings.gradle ./
COPY gradle ./gradle
COPY config ./config
COPY src ./src
ARG BUILD_GIT_COMMIT
RUN --mount=type=cache,target=/root/.gradle,sharing=locked test -n "$BUILD_GIT_COMMIT" && chmod +x gradlew && ./gradlew coreBootJar --no-daemon

FROM eclipse-temurin:25-jre-noble
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home app \
    && mkdir -p /app && chown app:app /app
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/build/libs/meomuneum-core.jar /app/app.jar
ARG BUILD_GIT_COMMIT
LABEL org.opencontainers.image.title="meomuneum-core" org.opencontainers.image.revision="$BUILD_GIT_COMMIT"
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
