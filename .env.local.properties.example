# Copy to .env.local.properties for Spring dev or test without prod. Java properties: do not quote values.
# CLI/JVM/OS and auto-loaded dotenv values take precedence; this import remains the fallback.
# Default JWT example is test-friendly. For dev, uncomment AUTH_JWT_SECRET and remove/comment TEST_AUTH_JWT_SECRET.
# For test, leave AUTH_JWT_SECRET absent: OS/dotenv relaxed binding can override auth.jwt.secret directly.
# Suffixes do not select profiles; do not keep alternate-profile JWT files in the working directory.
# Required for dev: supply a dedicated local DB, credentials and JWT (no secret default).
DEV_DB_URL=jdbc:mysql://localhost:3306/meomuneum_dev
DEV_DB_USERNAME=meomuneum_dev
DEV_DB_PASSWORD=replace_with_dev_password
# AUTH_JWT_SECRET=replace_with_a_separate_random_dev_jwt_secret_at_least_32_bytes

# Required for test: use a separate dedicated local DB and replace its credentials.
TEST_DB_URL=jdbc:mysql://localhost:3306/meomuneum_test
TEST_DB_USERNAME=meomuneum_test
TEST_DB_PASSWORD=replace_with_test_password

# Required for local login: replace these placeholders with separate random values.
# JWT and HMAC: at least 32 bytes each; generate each with openssl rand -hex 32.
TEST_AUTH_JWT_SECRET=replace_with_a_separate_random_test_jwt_secret_at_least_32_bytes
AUTH_STATE_HMAC_KEY=replace_with_a_separate_random_hmac_key_at_least_32_bytes
# AES replay key: base64 of 16, 24 or 32 random bytes; generate with openssl rand -base64 32.
AUTH_STATE_REPLAY_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes
# Required local location token key; generate separately with openssl rand -hex 32.
LOCATION_TOKEN_SECRET=replace_with_a_separate_random_location_secret_at_least_32_bytes

# dev/test Run/bootRun auto-starts the loopback member in the app JVM (no separate terminal required).
# The app closes only its own member; local authentication state disappears when that member stops.
# Optional: set false to use an external member started with ./gradlew hazelcastLocal.
AUTH_STATE_HAZELCAST_LOCAL_AUTO_START=true
# Required singleton backend; custom external member configuration must match these values.
# Concurrent dev/test apps need distinct member ports AND cluster names, one backend per cluster.
AUTH_STATE_HAZELCAST_ENABLED=true
AUTH_STATE_HAZELCAST_MEMBERS=127.0.0.1:15702
AUTH_STATE_HAZELCAST_CLUSTER_NAME=meomuneum-auth-local
AUTH_STATE_HAZELCAST_EXPECTED_MEMBER_COUNT=1
AUTH_BACKEND_REPLICA_COUNT=1

# Optional overrides; HTTP local cookies and all localhost/127.0.0.1 Origin ports are dev/test defaults.
AUTH_COOKIE_SECURE=false
AUTH_CORS_LOCAL_ALL_PORTS_ENABLED=true
# SERVER_PORT=8082
# SERVER_ADDRESS=127.0.0.1
# AUTH_CORS_ALLOWED_ORIGINS=https://an-explicit-additional-origin.example

# Optional service URLs; the test profile uses iTunes, mock images and stub speech.
RECOMMENDATION_AI_BASE_URL=http://localhost:8000
SPEECH_TRANSCRIPTION_AI_BASE_URL=http://localhost:8000
LOCATION_REVERSE_GEOCODING_BASE_URL=https://dapi.kakao.com
