      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "producer_id",
        "occurred_at",
        "epoch",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event_type": {
          "type": "string",
          "const": "CHAT_MESSAGE_CREATED"
        },
        "producer_id": {
          "type": "string",
          "pattern": "^chat:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "room_id",
            "room_seq",
            "message_id"
          ],
          "properties": {
            "room_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
