# Copy to .env and replace the placeholder passwords before running locally.
# Spring Boot does not automatically load .env files.
# Keep this file shell-compatible; quote values containing special characters.

DEV_DB_URL='jdbc:mysql://localhost:3306/meomuneum_dev'
DEV_DB_USERNAME='meomuneum_dev'
DEV_DB_PASSWORD='replace_with_dev_password'

TEST_DB_URL='jdbc:mysql://localhost:3306/meomuneum_test'
TEST_DB_USERNAME='meomuneum_test'
TEST_DB_PASSWORD='replace_with_test_password'

# JWT signing material must be supplied by the local environment or deployment secret store.
AUTH_JWT_SECRET='at-least-32-byte-development-only-secret-value'
AUTH_JWT_ISSUER='project-api'
AUTH_JWT_AUDIENCE='project-api'
AUTH_CORS_ALLOWED_ORIGINS='http://localhost:5173'
# Keep true for HTTPS deployments. Set false only for local HTTP browser testing.
AUTH_COOKIE_SECURE='true'

# AI recommendation service configuration.
RECOMMENDATION_PROVIDER='ai'
RECOMMENDATION_IMAGE_PROVIDER='ai'
RECOMMENDATION_IMAGE_MOCK_OUTCOME='usable'
RECOMMENDATION_AI_BASE_URL='http://localhost:8000'
RECOMMENDATION_IMAGE_TIMEOUT='60s'

# Optional iTunes Search API settings.
RECOMMENDATION_ITUNES_TIMEOUT='8s'
RECOMMENDATION_ITUNES_COUNTRY='US'

# Kakao Maps REST API key for backend reverse geocoding. Keep the real key only in .env or deployment secrets.
KAKAO_REST_API_KEY='replace_with_kakao_rest_api_key'

# Development-only STT substitute. Production keeps the provider unavailable until the AI contract is ready.
SPEECH_TRANSCRIPTION_PROVIDER='stub'
SPEECH_TRANSCRIPTION_STUB_TRANSCRIPT='비 올 때 듣기 좋은 노래를 추천해줘'

# Location resolution token and Kakao coordinate-to-region API credentials.
LOCATION_TOKEN_SECRET='at-least-32-byte-location-token-secret-value'
LOCATION_KAKAO_REST_API_KEY='replace_with_kakao_rest_api_key'
LOCATION_REVERSE_GEOCODING_BASE_URL='https://dapi.kakao.com'
LOCATION_REVERSE_GEOCODING_CONNECT_TIMEOUT='2s'
LOCATION_REVERSE_GEOCODING_READ_TIMEOUT='3s'

# Hourly physical deletion of expired chat messages. Keep enabled in normal operation.
# Disable only for controlled maintenance/testing; 24-hour valid-data filtering still applies.
CHAT_MESSAGE_CLEANUP_ENABLED='true'

# Configure these separately in the deployment environment for production.
# SPRING_PROFILES_ACTIVE=prod
# PROD_DB_URL='jdbc:mysql://your-production-host:3306/meomuneum_prod'
# PROD_DB_USERNAME='your-production-user'
# PROD_DB_PASSWORD='replace_with_production_password'

# Required audio preprocessing runtime: install FFmpeg on local/CI/production hosts.
# Set an absolute path when FFmpeg is not on the service PATH.
SPEECH_AUDIO_FFMPEG_PATH='ffmpeg'
# Timeout per input validation, encoding, or output validation process.
SPEECH_AUDIO_PROCESSING_TIMEOUT='15s'
# Optional existing writable directory; defaults to the JVM temporary directory.
# SPEECH_AUDIO_TEMPORARY_DIRECTORY='/tmp'

# 지역 메시지 전송 간격과 검토된 탐지 기준 활성화
CHAT_MESSAGE_MINIMUM_INTERVAL='1s'
CHAT_PERSONAL_CONTENT_DETECTION_ENABLED='true'

# Optional chat Redis foundation. Disabled until explicitly enabled; no product relay yet.
# Required when enabled: environment (lowercase letters/digits/hyphens), host, port.
CHAT_REDIS_ENABLED='false'
CHAT_REDIS_ENVIRONMENT='local'
CHAT_REDIS_HOST='localhost'
CHAT_REDIS_PORT='6379'
# Password is required when enabled. Use a dedicated Chat ACL user in deployment.
# 'default' is compatibility for the local fixture, not approval to share a production account.
CHAT_REDIS_USERNAME='default'
CHAT_REDIS_PASSWORD=''
# TLS stays true for any deployment, including EC2 + Docker. No plaintext fallback.
# Configure the JVM trust store for private CAs; false only for isolated local tests.
CHAT_REDIS_SSL='true'
CHAT_REDIS_CONNECT_TIMEOUT='1s'
CHAT_REDIS_COMMAND_TIMEOUT='1s'
CHAT_REDIS_REQUEST_QUEUE_SIZE='1024'
# Optional readable PEM CA file for private TLS certificates; empty uses the system trust roots.
CHAT_REDIS_SSL_CA_CERTIFICATE=''

# Separate app artifacts use separate DB identities/pool budgets on the same schema.
CORE_DB_URL='jdbc:mysql://localhost:3306/meomuneum_dev'
CORE_DB_USERNAME='replace_with_core_user'
CORE_DB_PASSWORD='replace_with_core_password'
CORE_DB_MAXIMUM_POOL_SIZE='10'
CORE_SERVER_PORT='8080'
CORE_SHUTDOWN_TIMEOUT='30s'
# Only the agreed migration executor may enable this; normal Tasks leave it false.
CORE_FLYWAY_ENABLED='false'
CHAT_DB_URL='jdbc:mysql://localhost:3306/meomuneum_dev'
CHAT_DB_USERNAME='replace_with_chat_user'
CHAT_DB_PASSWORD='replace_with_chat_password'
CHAT_DB_MAXIMUM_POOL_SIZE='10'
CHAT_SERVER_PORT='8081'
CHAT_SHUTDOWN_TIMEOUT='30s'
# Keep false until remaining P1 shared-state/recovery contracts are implemented.
# true currently requires the chat-isolated profile and rejects prod.
CHAT_RUNTIME_ENABLED='false'

# P1 Core session validation: opt in together in an isolated environment first.
CORE_CHAT_AUTH_ENABLED='false'
CHAT_AUTH_SERVICE_TOKEN_CURRENT='replace_with_dedicated_at_least_32_byte_service_key'
# Optional during rotation; must differ from current/JWT/location/Redis credentials.
CHAT_AUTH_SERVICE_TOKEN_NEXT=''
CHAT_CORE_AUTH_ENABLED='false'
CORE_INTERNAL_BASE_URL='https://core.internal.example.com'
CORE_AUTH_SERVICE_TOKEN='replace_with_same_current_or_next_service_key'
# Private CA: configure the Chat JVM trust store; no certificate/hostname bypass.
# JAVA_TOOL_OPTIONS='-Djavax.net.ssl.trustStore=/run/secrets/core-trust.p12 -Djavax.net.ssl.trustStorePassword=...'

# Best-effort sid revocation fast path; HTTP validation remains the authority.
CORE_AUTH_REDIS_ENABLED='false'
CORE_AUTH_PRODUCER_ID='core:11111111-1111-4111-8111-111111111111'
CORE_AUTH_REDIS_ENVIRONMENT='local'
CORE_AUTH_REDIS_HOST='redis.internal.example.com'
CORE_AUTH_REDIS_PORT='6379'
CORE_AUTH_REDIS_USERNAME='replace_with_publish_only_core_acl_user'
CORE_AUTH_REDIS_PASSWORD=''
CORE_AUTH_REDIS_SSL='true'
CORE_AUTH_REDIS_CA_CERTIFICATE=''
# Chat subscription also requires CHAT_REDIS_ENABLED=true and its dedicated ACL user.
CHAT_AUTH_REDIS_ENABLED='false'
CORE_AUTH_PRODUCER_IDS='core:11111111-1111-4111-8111-111111111111'

# P1 global participation: isolated verification only until remaining P1 is complete.
# Requires CHAT_CORE_AUTH_ENABLED=true, CHAT_REDIS_ENABLED=true and its environment/TLS/ACL settings.
# Apply the additive runtime migration with the single agreed migration executor first.
CHAT_DISTRIBUTED_PRESENCE_ENABLED='false'
