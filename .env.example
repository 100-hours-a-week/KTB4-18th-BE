# Copy to .env in the project working directory and replace all placeholders.
# Auto-loaded only for test without prod; dev/prod keep their existing environment injection.
# Reads .env, then ALL .env.* in Java String.compareTo lexical order; later values win.
# .env.10 precedes .env.2. Suffixes do not select profiles: test also reads .env.prod.
# Skips *.example/*.sample/*.template, directories, all symlinks and legacy properties imports.
# Single-line KEY=value and paired quotes; full-line # comments start in the first column.
# No export, multiline values or shell execution.
# CLI/JVM/OS values override dotenv; legacy .env.local.properties remains a fallback.

DEV_DB_URL='jdbc:mysql://localhost:3306/meomuneum_dev'
DEV_DB_USERNAME='meomuneum_dev'
DEV_DB_PASSWORD='replace_with_dev_password'

TEST_DB_URL='jdbc:mysql://localhost:3306/meomuneum_test'
TEST_DB_USERNAME='meomuneum_test'
TEST_DB_PASSWORD='replace_with_test_password'
# Required for real local test-profile login; separate random key, at least 32 bytes.
TEST_AUTH_JWT_SECRET='replace_with_a_separate_random_test_jwt_secret_at_least_32_bytes'

# JWT signing material must be supplied by the local environment or deployment secret store.
AUTH_JWT_SECRET='at-least-32-byte-development-only-secret-value'
AUTH_JWT_ISSUER='project-api'
AUTH_JWT_AUDIENCE='project-api'
AUTH_CORS_ALLOWED_ORIGINS='http://localhost:5173'
# Keep true for HTTPS deployments. Set false only for local HTTP browser testing.
AUTH_COOKIE_SECURE='true'

# Required authentication-state secrets; replace each placeholder independently.
# test automatically loads these values; .env.local.properties.example remains the legacy alternative.
# Required, separate random HMAC key, at least 32 bytes: openssl rand -hex 32.
AUTH_STATE_HMAC_KEY='replace_with_a_separate_random_hmac_key_at_least_32_bytes'
# Required base64 AES key (16/24/32 decoded bytes): openssl rand -base64 32.
AUTH_STATE_REPLAY_ENCRYPTION_KEY='replace_with_base64_encoded_32_random_bytes'

# AI recommendation service configuration.
RECOMMENDATION_PROVIDER='ai'
RECOMMENDATION_IMAGE_PROVIDER='ai'
RECOMMENDATION_IMAGE_MOCK_OUTCOME='usable'
RECOMMENDATION_AI_BASE_URL='http://localhost:8000'
RECOMMENDATION_IMAGE_TIMEOUT='60s'

# Optional iTunes Search API settings.
RECOMMENDATION_ITUNES_TIMEOUT='8s'
RECOMMENDATION_ITUNES_COUNTRY='US'

# Kakao Maps REST API key for backend reverse geocoding. Keep the real key only in .env or deployment secrets.
KAKAO_REST_API_KEY='replace_with_kakao_rest_api_key'

# Development-only STT substitute. Production keeps the provider unavailable until the AI contract is ready.
SPEECH_TRANSCRIPTION_PROVIDER='stub'
SPEECH_TRANSCRIPTION_STUB_TRANSCRIPT='비 올 때 듣기 좋은 노래를 추천해줘'

# Location resolution token and Kakao coordinate-to-region API credentials.
LOCATION_TOKEN_SECRET='at-least-32-byte-location-token-secret-value'
LOCATION_KAKAO_REST_API_KEY='replace_with_kakao_rest_api_key'
LOCATION_REVERSE_GEOCODING_BASE_URL='https://dapi.kakao.com'
LOCATION_REVERSE_GEOCODING_CONNECT_TIMEOUT='2s'
LOCATION_REVERSE_GEOCODING_READ_TIMEOUT='3s'

# Hourly physical deletion of expired chat messages. Keep enabled in normal operation.
# Disable only for controlled maintenance/testing; 24-hour valid-data filtering still applies.
CHAT_MESSAGE_CLEANUP_ENABLED='true'

# Configure these separately in the deployment environment for production.
# SPRING_PROFILES_ACTIVE=prod
# PROD_DB_URL='jdbc:mysql://your-production-host:3306/meomuneum_prod'
# PROD_DB_USERNAME='your-production-user'
# PROD_DB_PASSWORD='replace_with_production_password'

# Required audio preprocessing runtime: install FFmpeg on local/CI/production hosts.
# Set an absolute path when FFmpeg is not on the service PATH.
SPEECH_AUDIO_FFMPEG_PATH='ffmpeg'
# Timeout per input validation, encoding, or output validation process.
SPEECH_AUDIO_PROCESSING_TIMEOUT='15s'
# Optional existing writable directory; defaults to the JVM temporary directory.
# SPEECH_AUDIO_TEMPORARY_DIRECTORY='/tmp'

# 지역 메시지 전송 간격과 검토된 탐지 기준 활성화
CHAT_MESSAGE_MINIMUM_INTERVAL='1s'
CHAT_PERSONAL_CONTENT_DETECTION_ENABLED='true'
